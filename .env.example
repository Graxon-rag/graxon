PORT=8888
ENV_TYPE=development
LOG_LEVEL=info
DOCS_USERNAME=admin
DOCS_PASSWORD=admin
GRAXON_PUBLIC_URL=http://localhost:8888

# Frontend
CLIENTS="http://locahost:5995"


# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password


# Postgrsql
POSTGRESQL_USERNAME=graxon_admin
POSTGRESQL_PASSWORD=password
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=5433


# qDrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334


# Neo4j
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password


# Minio
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=graxon_admin
MINIO_ROOT_PASSWORD=password
MINIO_REGION=ap-south-1


# Rabbitmq
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=graxon_admin
RABBITMQ_PASSWORD=password
RABBITMQ_MANAGEMENT_PORT=15672
DOCUMENT_CONSUMER_COUNT=5
WEBHOOK_CONSUMER_COUNT=2

# External Call
EMBEDDING_CHUNK_BATCH_SIZE=30


# Chunks
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
MAX_CHUNKS=10000
MAX_CHUNK_SIZE_MB=10
MAX_PAGES_PER_BATCH=2
# MAX_PAGES_PER_BATCH=20
TAIL_CARRY_CHARS=500
GROUP_SIZE_FOR_RAG_CHUNK=10
MAX_GROUP_SIZE_FOR_RAG_CHUNK=20
OBJECTS_PER_BUFFER=500
ROWS_PER_IO_BUFFER=500

VIDEO_SEGMENT_DURATION_MINUTES=10.0
VIDEO_OVERLAP_MINUTES=1.0
VIDEO_MAX_DURATION_PER_RAG_CHUNK=2.0
VIDEO_MAX_WORDS_PER_RAG_CHUNK=300


# Vector Similar
GTE_EDGE_VECTOR_SIMILAR_THRESHOLD=0.75
GTE_QDRANT_POINT_SCORE_THRESHOLD=0.45


##  Expert Query
# How many mapping lane need to took for getting more chunks
EQ_MAX_LANE_COUNT=3
# How many lane entity pick for getting chunk; example for 'tag' we find 10 object{value:string, weight:float} then will we only pick top 3 where weight>=EQ_GTE_LANE_WEIGHT_THRESHOLD
EQ_MAX_LANE_ENTITY=3
# Took only those lane where weight is greater than or equal EQ_GTE_LANE_WEIGHT_THRESHOLD
EQ_GTE_LANE_WEIGHT_THRESHOLD=0.7
# The Max we can take after sparse embedding
EQ_MAX_LANE_CHUNKS=5
# After all analysis take top EQ_MAX_CHUNKS for getting prev/next and vector similar chunks
EQ_MAX_CHUNKS=5
